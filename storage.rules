rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuth()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && (
          firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.developerAccess == true
          || firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.staffRole in ['developer', 'operator', 'admin']
        );
    }

    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
