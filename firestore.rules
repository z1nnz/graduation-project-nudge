rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isStaff() {
      return isAuth()
        && exists(userDocPath())
        && (
          get(userDocPath()).data.developerAccess == true
          || get(userDocPath()).data.staffRole in ['developer', 'operator', 'admin']
        );
    }

    function hasProtectedStaffFields() {
      return request.resource.data.keys().hasAny([
        'developerAccess',
        'staffRole',
        'staffPermissions'
      ]);
    }

    function changesProtectedStaffFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'developerAccess',
        'staffRole',
        'staffPermissions'
      ]);
    }

    function hasGroupProjectionFields() {
      return request.resource.data.keys().hasAny([
        'groupId', 'groupName', 'isGroupOwner'
      ]);
    }

    function validGroupProjectionChange(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['groupId', 'groupName', 'isGroupOwner']);
      return !changed
        || (
          request.resource.data.keys().hasAll([
            'groupId', 'groupName', 'isGroupOwner'
          ])
          && existsAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          )
          && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.status == 'active'
          && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.memberIds.hasAll([userId])
          && getAfter(
            /databases/$(database)/documents/groups/$(request.resource.data.groupId)
          ).data.name == request.resource.data.groupName
          && request.resource.data.isGroupOwner
            == (
              getAfter(
                /databases/$(database)/documents/groups/$(request.resource.data.groupId)
              ).data.ownerId == userId
            )
        )
        || (
          !request.resource.data.keys().hasAny([
            'groupId', 'groupName', 'isGroupOwner'
          ])
          && (
            !existsAfter(
              /databases/$(database)/documents/groups/$(resource.data.groupId)
            )
            || !getAfter(
              /databases/$(database)/documents/groups/$(resource.data.groupId)
            ).data.memberIds.hasAny([userId])
          )
        );
    }

    function changesOnlyOwnGroupMembership(groupId) {
      let beforeMembers = resource.data.memberIds.toSet();
      let afterMembers = request.resource.data.memberIds.toSet();
      let addedMembers = afterMembers.difference(beforeMembers);
      let removedMembers = beforeMembers.difference(afterMembers);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.memberIds
        && (
          (
            addedMembers.hasOnly([request.auth.uid])
            && removedMembers.size() == 0
            && resource.data.status == 'active'
            && getAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.groupId == groupId
          )
          || (
            removedMembers.hasOnly([request.auth.uid])
            && addedMembers.size() == 0
            && getAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.groupId != groupId
          )
        );
    }

    // ─── /users/{userId} ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId)
        && !hasProtectedStaffFields()
        && !hasGroupProjectionFields();
      allow update: if isOwner(userId)
        && !changesProtectedStaffFields()
        && validGroupProjectionChange(userId);
      allow delete: if false;

      // ─── /users/{userId}/friends/{friendId} ───────────────────────
      match /friends/{friendId} {
        allow read: if isOwner(userId) || (isAuth() && request.auth.uid == friendId);
        allow write: if isAuth()
          && request.resource.data.id == friendId
          && (isOwner(userId) || request.auth.uid == friendId);
        allow delete: if isOwner(userId) || (isAuth() && request.auth.uid == friendId);
      }
    }

    // ─── /friend_requests/{requestId} ────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'senderId', 'senderNudgeId', 'senderName',
          'receiverId', 'receiverNudgeId', 'receiverName',
          'status', 'createdAt'
        ]);
      allow update: if isAuth() && (
        // Receiver can accept or decline
        (resource.data.receiverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'])
        ||
        // Sender can cancel their own pending request
        (resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        ||
        // Sender can resend a request (update all fields, but must keep sender/receiver IDs)
        (resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.status == 'pending')
      );
      allow delete: if false;
    }

    // ─── /friend_messages/{messageId} ────────────────────────────────
    match /friend_messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll(['receiverId', 'senderId', 'senderName', 'content', 'type', 'createdAt']);
      allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
    }

    // ─── /guardian_requests/{requestId} ────────────────────────────────
    match /guardian_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.senderRole in ['guardian', 'child']
        && request.resource.data.receiverRole in ['guardian', 'child']
        && request.resource.data.senderRole != request.resource.data.receiverRole
        && request.resource.data.keys().hasAll([
          'senderId', 'senderNudgeId', 'senderNickname', 'senderRole',
          'receiverId', 'receiverNudgeId', 'receiverRole',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAuth()
        && (
          (resource.data.receiverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['accepted', 'declined']
            && (
              request.resource.data.status == 'declined'
              || existsAfter(
                /databases/$(database)/documents/family_links/$(requestId)
              )
            )) ||
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['declined', 'cancelled'])
        );
      allow delete: if isAuth()
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid);
    }

    // ─── /family_links/{linkId} ──────────────────────────────────────
    // Canonical family relationship. Encouragements and goals live under
    // the relationship, never in either participant's private user document.
    match /family_links/{linkId} {
      function isFamilyParticipant() {
        return isAuth()
          && resource.data.participantIds.hasAny([request.auth.uid]);
      }

      function isActiveFamilyParticipant() {
        return isFamilyParticipant() && resource.data.status == 'active';
      }

      function validConsentScopes(scopes) {
        return scopes.keys().hasOnly([
            'summary', 'weeklyReport', 'taskCategories', 'healthTrends'
          ])
          && scopes.keys().hasAll([
            'summary', 'weeklyReport', 'taskCategories', 'healthTrends'
          ])
          && scopes.summary is bool
          && scopes.weeklyReport is bool
          && scopes.taskCategories is bool
          && scopes.healthTrends is bool;
      }

      allow read: if isFamilyParticipant();

      allow create: if isAuth()
        && existsAfter(
          /databases/$(database)/documents/guardian_requests/$(linkId)
        )
        && getAfter(
          /databases/$(database)/documents/guardian_requests/$(linkId)
        ).data.receiverId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/guardian_requests/$(linkId)
        ).data.status == 'accepted'
        && request.resource.data.status == 'active'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.guardianId
          == (
            getAfter(
              /databases/$(database)/documents/guardian_requests/$(linkId)
            ).data.senderRole == 'guardian'
              ? getAfter(
                  /databases/$(database)/documents/guardian_requests/$(linkId)
                ).data.senderId
              : getAfter(
                  /databases/$(database)/documents/guardian_requests/$(linkId)
                ).data.receiverId
          )
        && request.resource.data.childId
          == (
            getAfter(
              /databases/$(database)/documents/guardian_requests/$(linkId)
            ).data.senderRole == 'child'
              ? getAfter(
                  /databases/$(database)/documents/guardian_requests/$(linkId)
                ).data.senderId
              : getAfter(
                  /databases/$(database)/documents/guardian_requests/$(linkId)
                ).data.receiverId
          )
        && request.resource.data.guardianId != request.resource.data.childId
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasOnly([
          request.resource.data.guardianId,
          request.resource.data.childId
        ])
        && validConsentScopes(request.resource.data.consentScopes)
        && request.resource.data.consentScopes.summary == true
        && request.resource.data.consentScopes.weeklyReport == false
        && request.resource.data.consentScopes.taskCategories == false
        && request.resource.data.consentScopes.healthTrends == false
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'guardianId', 'childId', 'participantIds',
          'status', 'consentScopes', 'createdAt', 'updatedAt'
        ]);

      allow update: if isActiveFamilyParticipant()
        && (
          (
            request.auth.uid == resource.data.childId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['consentScopes', 'updatedAt'])
            && validConsentScopes(request.resource.data.consentScopes)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'endedBy', 'endedAt', 'updatedAt'])
            && request.resource.data.status == 'ended'
            && request.resource.data.endedBy == request.auth.uid
          )
        );
      allow delete: if false;

      match /encouragements/{encouragementId} {
        function familyLink() {
          return get(
            /databases/$(database)/documents/family_links/$(linkId)
          ).data;
        }

        function isFamilyParticipant() {
          return isAuth()
            && familyLink().participantIds.hasAny([request.auth.uid]);
        }

        allow read: if isFamilyParticipant();
        allow create: if isFamilyParticipant()
          && familyLink().status == 'active'
          && request.auth.uid == familyLink().guardianId
          && request.resource.data.senderId == familyLink().guardianId
          && request.resource.data.recipientId == familyLink().childId
          && request.resource.data.status == 'sent'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'senderId', 'recipientId', 'title', 'message',
            'status', 'createdAt'
          ]);
        allow update: if isFamilyParticipant()
          && familyLink().status == 'active'
          && request.auth.uid == familyLink().childId
          && resource.data.status == 'sent'
          && request.resource.data.status == 'acknowledged'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acknowledgedAt']);
        allow delete: if false;
      }

      match /goals/{goalId} {
        function familyLink() {
          return get(
            /databases/$(database)/documents/family_links/$(linkId)
          ).data;
        }

        function isFamilyParticipant() {
          return isAuth()
            && familyLink().participantIds.hasAny([request.auth.uid]);
        }

        allow read: if isFamilyParticipant();
        allow create: if isFamilyParticipant()
          && familyLink().status == 'active'
          && request.auth.uid == familyLink().guardianId
          && request.resource.data.proposedBy == familyLink().guardianId
          && request.resource.data.decisionBy == familyLink().childId
          && request.resource.data.status == 'proposed'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'title', 'message', 'status', 'proposedBy',
            'decisionBy', 'createdAt', 'updatedAt'
          ]);
        allow update: if isFamilyParticipant()
          && familyLink().status == 'active'
          && request.auth.uid == familyLink().childId
          && (
            (
              resource.data.status == 'proposed'
              && request.resource.data.status in ['accepted', 'declined']
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status', 'acceptedAt', 'declinedAt', 'updatedAt'
                ])
            )
            || (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'completed'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'completedAt', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      match /bond_events/{eventId} {
        function familyLink() {
          return get(
            /databases/$(database)/documents/family_links/$(linkId)
          ).data;
        }

        function isFamilyParticipant() {
          return isAuth()
            && familyLink().participantIds.hasAny([request.auth.uid]);
        }

        function validAcknowledgementEvent() {
          return request.resource.data.type == 'acknowledgement'
            && request.resource.data.points == 3
            && eventId == 'encouragement_' + request.resource.data.sourceId
            && getAfter(
              /databases/$(database)/documents/family_links/$(linkId)/encouragements/$(request.resource.data.sourceId)
            ).data.status == 'acknowledged';
        }

        function validGoalCompletedEvent() {
          return request.resource.data.type == 'goalCompleted'
            && request.resource.data.points == 10
            && eventId == 'goal_' + request.resource.data.sourceId
            && getAfter(
              /databases/$(database)/documents/family_links/$(linkId)/goals/$(request.resource.data.sourceId)
            ).data.status == 'completed';
        }

        allow read: if isFamilyParticipant();
        allow create: if isFamilyParticipant()
          && familyLink().status == 'active'
          && request.auth.uid == familyLink().childId
          && request.resource.data.actorId == familyLink().childId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'type', 'sourceId', 'actorId', 'points',
            'createdAt'
          ])
          && (validAcknowledgementEvent() || validGoalCompletedEvent());
        allow update, delete: if false;
      }
    }

    // ─── /groups/{groupId} ────────────────────────────────────────────
    // Canonical group state. User document group fields are compatibility
    // projections consumed by older App and Web screens.
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && request.resource.data.status == 'active';
      allow update: if isAuth() && (
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerId in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'status', 'updatedAt'])
        )
        || changesOnlyOwnGroupMembership(groupId)
      );
      allow delete: if isAuth()
        && resource.data.ownerId == request.auth.uid
        && resource.data.memberIds.size() == 1
        && resource.data.memberIds.hasOnly([request.auth.uid])
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.groupId != groupId;
    }

    // ─── /group_requests/{requestId} ──────────────────────────────────
    match /group_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid
        || resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(
          /databases/$(database)/documents/groups/$(request.resource.data.groupId)
        )
        && get(
          /databases/$(database)/documents/groups/$(request.resource.data.groupId)
        ).data.ownerId == request.auth.uid
        && get(
          /databases/$(database)/documents/groups/$(request.resource.data.groupId)
        ).data.name == request.resource.data.groupName
        && request.resource.data.receiverId != request.auth.uid
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.receiverId)
        )
        && request.resource.data.keys().hasAll([
          'senderId', 'receiverId', 'groupId', 'groupName',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderNudgeId', 'senderNickname',
          'receiverId', 'groupId', 'groupName',
          'status', 'createdAt'
        ]);
      allow update: if isAuth() && (
        (
          resource.data.receiverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['accepted', 'declined']
        )
        || (
          resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
        )
      );
      allow delete: if false;
    }

    // ─── /rooms/{roomId} ─────────────────────────────────────────────
    // Study rooms: authenticated members can read rooms they belong to.
    // The 'memberIds' array field is used for efficient array-contains queries.
    match /rooms/{roomId} {
      // Any authenticated user can read rooms (needed for QR-code join flow)
      allow read: if isAuth();

      // Any authenticated user can create a room (they become owner)
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.hasAll([request.auth.uid]);

      // Any authenticated member of the room can update it
      // (members update their own presence, owner updates settings)
      allow update: if isAuth()
        && (resource.data.memberIds.hasAll([request.auth.uid])
            || request.resource.data.memberIds.hasAll([request.auth.uid]));

      allow delete: if isAuth()
        && resource.data.ownerId == request.auth.uid;

      // ─── /rooms/{roomId}/calls/{callUserId} ───────────────────────
      match /calls/{callUserId} {
        allow read: if isAuth();
        allow write: if isOwner(callUserId);
        allow delete: if isOwner(callUserId);

        // ─── sdpExchange ────────────────────────────────────────────
        match /sdpExchange/{senderId} {
          allow read: if isAuth() && (
            request.auth.uid == callUserId || request.auth.uid == senderId
          );
          allow write: if isAuth() && request.auth.uid == senderId;
          allow delete: if isAuth() && request.auth.uid == senderId;
        }

        // ─── ICE candidates ─────────────────────────────────────────
        match /candidates/{candidateId} {
          allow read: if isAuth() && request.auth.uid == callUserId;
          allow create: if isAuth()
            && request.resource.data.senderId == request.auth.uid;
          allow delete: if isAuth()
            && resource.data.senderId == request.auth.uid;
        }
      }
    }

    // ─── /shop_items/{itemId} ──────────────────────────────────────────
    match /shop_items/{itemId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /catalog_counters/{counterId} {
      allow read, write: if isStaff();
    }
  }
}
